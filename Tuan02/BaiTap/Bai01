import numpy as np

print("1. Tạo một dãy số a có N phần tử (N = 10)")

# CÁC BẠN LÀM BÀI Ở ĐÂY
a = np.array([120, 183, 160, 175, 145, 162, 190, 160, 152, 162])

print("Day so a:", a)


Yêu cầu 2:
print("\n2. Các thao tác tính toán đơn giản với dãy số a")

# a. Bình phương
a2 = a ** 2

# b. Độ dài dãy
na = len(a)

print("a. Binh phuong a:\n", a2)
print("b. Do dai a:", na)

# c. Max, Min, Mean
v_max = np.max(a)
v_min = np.min(a)
v_avg = np.mean(a)

print(f"c. Gia tri lon nhat: [{v_max}], gia tri nho nhat: [{v_min}], gia tri trung binh [{v_avg}]")

# d. Phương sai và độ lệch chuẩn (chia N-1)
mu = v_avg
v_sigma2 = np.sum((a - mu) ** 2) / (na - 1)
v_var = np.sqrt(v_sigma2)

print(f"d. Phuong sai: [{v_sigma2:.2f}] va do lech chuan: [{v_var:.2f}]")


